SRCDIR="$BUILD/image/system/usr/share/bootloader"
DSTDIR="$RELEASE_DIR/3rdparty/bootloader"

copy_matches() {
  local dest="${@: -1}"
  local sources=()
  local pattern

  shopt -s nullglob
  for pattern in "${@:1:$#-1}"; do
    sources+=(${pattern})
  done
  shopt -u nullglob

  if [ ${#sources[@]} -gt 0 ]; then
    cp -a "${sources[@]}" "$dest"
  fi
}

mkdir -p "$DSTDIR"
  copy_matches "$SRCDIR"/*.scr "$SRCDIR"/*script "$DSTDIR"

  if find_file_path "bootloader/${UBOOT_SYSTEM}.ini"; then
    cp -av "${FOUND_PATH}" "$DSTDIR/boot.ini"
  fi

mkdir -p "$DSTDIR/amlogic"
  ln -sf "$DSTDIR/amlogic" "$DSTDIR/dtb"
  case ${DEVICE:-$PROJECT} in
    AMLGX)
      copy_matches \
        "$SRCDIR"/*gxbb*.dtb \
        "$SRCDIR"/*gxl*.dtb \
        "$SRCDIR"/*gxm*.dtb \
        "$SRCDIR"/*g12a*.dtb \
        "$SRCDIR"/*g12b*.dtb \
        "$SRCDIR"/*sm1*.dtb \
        "$DSTDIR/amlogic"
      ;;
  esac
